# Copy this file to .env and fill in the real values. Never commit .env.

PORT=3000

# Database (Supabase: Connect button > ORMs > Prisma).
# DATABASE_URL = transaction pooler (port 6543) for the running app.
# DIRECT_URL   = session pooler (port 5432) for migrations and the seed script.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Tokens
JWT_ACCESS_SECRET="change-me-long-random-string"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Frontend addresses allowed to call this API (comma-separated)
CORS_ORIGINS="http://localhost:5173"

# Link used in the password reset email
FRONTEND_URL="http://localhost:5173"

# Email (clinic Gmail with an app password). Leave empty in development:
# the reset link is printed in the server console instead.
MAIL_USER=""
MAIL_APP_PASSWORD=""
MAIL_FROM="OCULA <no-reply@example.com>"

# The one admin account, created by `npm run db:seed` if no admin exists yet.
# The admin must change this password on first login. You can clear these after seeding.
ADMIN_EMAIL="admin@example.com"
ADMIN_PHONE="09170000000"
ADMIN_INITIAL_PASSWORD="change-me-at-least-12-chars"
ADMIN_FULL_NAME="OCULA Administrator"
