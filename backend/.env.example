# Copy this file to .env and fill in the real values. Never commit .env.

PORT=3000

# Database (Supabase). Pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Tokens
JWT_ACCESS_SECRET="change-me-long-random-string"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Frontend addresses allowed to call this API (comma-separated)
CORS_ORIGINS="http://localhost:5173"

# Link used in the password reset email
FRONTEND_URL="http://localhost:5173"

# Email (clinic Gmail with an app password). Leave empty in development:
# the reset link is printed in the server console instead.
MAIL_USER=""
MAIL_APP_PASSWORD=""
MAIL_FROM="OCULA <no-reply@example.com>"
